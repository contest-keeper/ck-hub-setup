# Copy to .env (git ignores it) and fill it in. Make the password long and random, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# The name organizers and sticks use to reach the Hub. Its DNS record must point at this machine.
CK_DOMAIN=hub.example.org
# Pin a version in production instead of latest.
CK_HUB_IMAGE=ghcr.io/contest-keeper/ck-hub:latest
